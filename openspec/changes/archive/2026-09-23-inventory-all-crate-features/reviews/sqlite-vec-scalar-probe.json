{
  "sqlite": "3.53.4",
  "build": "previous local dynamic extension, not Cargo SQLITE_CORE",
  "results": [
    {
      "sql": "select hex(vec_normalize('[0,0]'))",
      "result": "0000C07F0000C07F"
    },
    {
      "sql": "select vec_to_json(vec_normalize('[0,0]'))",
      "error": "invalid float32 vector: element 0 is NaN"
    },
    {
      "sql": "select vec_to_json(vec_normalize('[3,4]'))",
      "result": "[0.600000,0.800000]"
    },
    {
      "sql": "select vec_to_json(vec_slice('[1,2,3]',0,2))",
      "result": "[1.000000,2.000000]"
    },
    {
      "sql": "select vec_to_json(vec_slice('[1,2,3]',0.9,2.9))",
      "result": "[1.000000,2.000000]"
    },
    {
      "sql": "select vec_to_json(vec_slice('[1,2,3]',1,1))",
      "error": "slice 'start' index is equal to the 'end' index, vectors must have non-zero length"
    },
    {
      "sql": "select vec_to_json(vec_slice(vec_bit(x'0102'),0,8))",
      "result": "[1,0,0,0,0,0,0,0]"
    },
    {
      "sql": "select vec_to_json(vec_slice(vec_bit(x'0102'),1,8))",
      "error": "start index must be divisible by 8."
    }
  ]
}
