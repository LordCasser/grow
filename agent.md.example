---
# Copy this file to one of the following locations and rename it to <agent-id>.md:
#   Project: .grow/agents/<agent-id>.md
#   User:    ~/.grow/agents/<agent-id>.md
#
# The file path is the stable Agent ID. `name` is display metadata only.
# Top-level keys use camelCase. Fields inside `toolConfig.tools` use snake_case.
# Unknown keys fail parsing. `model`, `mode`, `permission`, `permissions`,
# `permissionMode`, `variant`, and `request` are not Agent settings: Grow keeps
# model and permission selection in session state, so these keys are rejected.

name: example-agent
description: >-
  A complete Grow Agent definition showing every supported frontmatter feature.

# Worker-only definitions remain available to parent Agents but are hidden from
# the primary-session Agent picker. This is definition metadata, not a TUI setting.
subagentOnly: true

# How the Markdown body below contributes to the system prompt:
#   extend (default): append it to Grow's built-in prompt.
#   full:             replace only the optional standard/role guidance.
# Mandatory foundation, audience, active Behavior, and session extensions remain.
promptComposition: extend

# Base tool declaration. Runtime injection, capability/depth filtering, Agent
# filters, session clamps, and Behavior gates are applied later and can only
# narrow this result.
toolPreset: grow-build

# Optional subagent defaults. They do not select a provider/model.
# capabilityMode: read-only | read-write | execute | all
capabilityMode: read-write
# effort: low | medium | high | xhigh | max
effort: high
# maxTurns must be greater than zero. A parent session may impose a lower limit.
maxTurns: 40
# isolation: none | worktree
isolation: worktree
# Default to a background launch when this definition is spawned as a subagent.
background: false

# Preload named Skills, discover the remaining Skills for the workspace, and
# optionally inherit the parent session's discovered Skills in a subagent.
skills:
  - coding
discoverSkills: true
inheritSkills: true

# Discover and inject applicable AGENTS.md files.
agentsMd: true

# When true, Grow may add session capabilities such as memory, web_fetch, LSP,
# the Grow write fallback, and plan-mode tools. Set false for an exact toolset.
injectDefaultTools: true

# Final Agent-authored filters. Omit/empty `tools` to allow every assembled
# tool. The denylist takes priority. Subagent authorization is separate.
tools:
  - read_file
  - grep
  - list_dir
  - run_terminal_cmd
disallowedTools:
  - deploy_app

subagents:
  allow:
    - explore
    - general-purpose
  deny: []

# Additional tools are layered after toolPreset. Per-tool record keys use the
# tools wire contract.
additionalTools:
  - id: Grow:read_file
    params: {}
    name_override: inspect_file
    params_name_overrides:
      target_file: path
    description_override: Read a UTF-8 text file or a supported document.
    kind: read
  - id: Grow:grep
    params: null
    name_override: inspect_matches
    params_name_overrides: null
    description_override: null
    kind: search

# When this definition is spawned as a subagent, Agent-owned MCP servers are
# available to trusted, non-plugin Agent files. A string references a server
# already configured by the parent session. An object declares an inline ACP
# MCP server. Plugin Agents may only inherit MCPs.
mcpServers:
  - project-search
  - local-tools:
      type: stdio
      command: /absolute/path/to/local-mcp-server
      args:
        - --stdio
      env:
        - name: EXAMPLE_MODE
          value: local

# Parent MCP inheritance accepts `all`, `none`, `{ named: [...] }`, or
# `{ except: [...] }`.
mcpInheritance:
  except:
    - private-parent-server

# Inline hooks use the same schema as Grow hook files. Project Agent hooks only
# run after the folder is trusted; plugin Agent hooks are ignored for security.
hooks:
  pre_tool_use:
    - matcher: run_terminal_cmd
      hooks:
        - type: command
          command: ./scripts/check-command.sh
          timeout: 10
  post_tool_use:
    - matcher: hashline_edit
      hooks:
        - type: command
          command: ./scripts/format-changed-files.sh

# Persistent memory scope used when this definition is spawned as a subagent:
#   user    -> ~/.grow/agent-memory/<agent-id>/
#   project -> <project>/.grow/agent-memory/<agent-id>/
#   local   -> <project>/.grow/agent-memory-local/<agent-id>/
memory: project

# Require a tool call before a turn may finish. `recovery` is a harness policy
# hint; all delay values are milliseconds.
completionRequirement:
  tool: complete_task
  reminder: Finish the task and call complete_task before ending the turn.
  recovery:
    maxRetries: 3
    baseDelayMs: 1000
    maxDelayMs: 10000

---

You are a focused software engineering Agent.

Understand the existing architecture before changing it. Make the smallest
coherent change that satisfies the task, verify the affected behavior, and
report unresolved risks clearly.
